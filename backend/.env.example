# ChainGuard AI - Environment Configuration Example
# Copy to .env and adjust variables as needed

# Environment: development | staging | production
CHAINGUARD_ENV=development

# Server Host & Port
HOST=127.0.0.1
PORT=8000

# Database Configuration (PostgreSQL or local SQLite for development)
# SQLite fallback default: sqlite:///./chainguard.db
# PostgreSQL example: postgresql+psycopg2://user:password@localhost:5432/chainguard_db
DATABASE_URL=sqlite:///./chainguard.db

# Security & CORS
SECRET_KEY=change-this-to-a-secure-random-secret-in-production
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Integration Connector Endpoints & Credentials (Placeholders)
SAP_S4HANA_ODATA_URL=https://sap-gateway.enterprise.example.com/odata/v4
SAP_CLIENT_ID=your-sap-oauth-client-id
SAP_CLIENT_SECRET=your-sap-oauth-client-secret

ORACLE_NETSUITE_URL=https://rest.netsuite.example.com/services/rest/record/v1
ORACLE_TOKEN_ID=your-netsuite-token-id

MANHATTAN_WMS_URL=https://wms.manhattan.example.com/api/v1
PROJECT44_TMS_URL=https://na12.api.project44.com/v4
COUPA_API_URL=https://enterprise.coupahost.com/api

# AI Agent Service Keys (Optional / Phase 2+)
AI_AGENT_SERVICE_KEY=placeholder-agent-secret-key

